<div class="bg-white">
    <!-- Hero Section -->
    <div class="relative bg-gray-50 overflow-hidden pt-16 pb-24">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <h1 class="text-5xl md:text-7xl font-extrabold text-indigo-900 tracking-tight mb-6">
                FILHAL FEST <span class="text-indigo-500">2026</span>
            </h1>
            <p class="mt-4 max-w-2xl text-xl text-gray-500 mx-auto mb-10">
                The ultimate battle between Hermos and Gibraltar. Access live results, team standings, and media instantly.
            </p>
            
            <div class="flex justify-center gap-4">
                <a href="/results" class="bg-indigo-600 text-white px-8 py-3 rounded-xl font-bold text-lg hover:bg-indigo-700 shadow-lg transition">View Results</a>
                {{#unless user}}
                    <a href="/login" class="bg-white text-indigo-600 border-2 border-indigo-100 px-8 py-3 rounded-xl font-bold text-lg hover:bg-indigo-50 transition">Participant Login</a>
                {{/unless}}
            </div>
        </div>
    </div>

    <!-- Mini Scoreboard -->
    <div class="max-w-4xl mx-auto px-4 -mt-12 relative z-10">
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-6 flex justify-around items-center text-center">
            <div>
                <div class="text-sm font-bold text-gray-400 uppercase">Hermos</div>
                <div class="text-3xl font-black text-gray-900">{{scores.Hermos.total}}</div>
            </div>
            <div class="px-6 border-x border-gray-100">
                <div class="text-xs font-bold text-indigo-400 uppercase tracking-widest mb-1">Current Leader</div>
                <div class="text-xl font-bold text-indigo-900">{{champion}}</div>
            </div>
            <div>
                <div class="text-sm font-bold text-gray-400 uppercase">Gibraltar</div>
                <div class="text-3xl font-black text-gray-900">{{scores.Gibraltar.total}}</div>
            </div>
        </div>
    </div>
</div>