<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
        <div class="text-center mb-8">
            <h2 class="text-3xl font-extrabold text-gray-900">{{role}} Login</h2>
            <p class="text-gray-500 mt-2">Welcome back to Filhal Fest</p>
        </div>

        {{#if error}}
            <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6">
                <p class="text-red-700 text-sm font-medium">{{error}}</p>
            </div>
        {{/if}}

        <form action="{{#if isAdmin}}/admin/login{{else}}/login{{/if}}" method="POST" class="space-y-6">
            <div>
                <label class="block text-sm font-medium text-gray-700">
                    {{#if isAdmin}}Admin Username{{else}}Chess Number{{/if}}
                </label>
                <input type="text" name="{{#if isAdmin}}username{{else}}chessNumber{{/if}}" required 
                       class="mt-1 w-full border-gray-300 rounded-lg shadow-sm py-2 px-3 border focus:ring-indigo-500 focus:border-indigo-500">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Password</label>
                <input type="password" name="password" required 
                       class="mt-1 w-full border-gray-300 rounded-lg shadow-sm py-2 px-3 border focus:ring-indigo-500 focus:border-indigo-500">
            </div>

            <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-md text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none">
                Sign In
            </button>
        </form>
    </div>
</div>