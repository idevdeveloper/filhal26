                    <h3 class="card-title text-dark fw-bold mb-3">{{champions.juniorGirls.name}}</h3>
                    <p class="mb-1 text-secondary">Chest No: <strong>{{champions.juniorGirls.chestNumber}}</strong></p>
                    <p class="mb-3 text-secondary">Team: <strong class="text-uppercase">{{champions.juniorGirls.team}}</strong></p>
                    <div class="badge bg-danger fs-6 px-3 py-2">Points: {{champions.juniorGirls.totalPoints}}</div>
                </div>
            </div>
        </div>

        <!-- Senior Boys -->
        <div class="col-md-4">
            <div class="card shadow border-primary h-100">
                <div class="card-header bg-primary text-white fw-semibold">Senior — Boys</div>
                <div class="card-body text-center py-4">
                    <h3 class="card-title text-dark fw-bold mb-3">{{champions.seniorBoys.name}}</h3>
                    <p class="mb-1 text-secondary">Chest No: <strong>{{champions.seniorBoys.chestNumber}}</strong></p>
                    <p class="mb-3 text-secondary">Team: <strong class="text-uppercase">{{champions.seniorBoys.team}}</strong></p>
                    <div class="badge bg-primary fs-6 px-3 py-2">Points: {{champions.seniorBoys.totalPoints}}</div>
                </div>
            </div>
        </div>

        <!-- Senior Girls -->
        <div class="col-md-4">
            <div class="card shadow border-danger h-100">
                <div class="card-header bg-danger text-white fw-semibold">Senior — Girls</div>
                <div class="card-body text-center py-4">
                    <h3 class="card-title text-dark fw-bold mb-3">{{champions.seniorGirls.name}}</h3>
                    <p class="mb-1 text-secondary">Chest No: <strong>{{champions.seniorGirls.chestNumber}}</strong></p>
                    <p class="mb-3 text-secondary">Team: <strong class="text-uppercase">{{champions.seniorGirls.team}}</strong></p>
                    <div class="badge bg-danger fs-6 px-3 py-2">Points: {{champions.seniorGirls.totalPoints}}</div>
                </div>
            </div>
        </div>
    </div>
</div>