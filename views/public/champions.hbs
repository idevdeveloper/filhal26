<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">🏆 Filhal Fest Individual Champions</h1>
        <p class="text-muted">Honoring the top-performing individuals across categories and genders.</p>
    </div>

    <div class="row g-4">
        <!-- Sub Junior Boys -->
        <div class="col-md-4">
            <div class="card shadow border-primary h-100">
                <div class="card-header bg-primary text-white fw-semibold">Sub Junior — Boys</div>
                <div class="card-body text-center py-4">
                    <h3 class="card-title text-dark fw-bold mb-3">{{champions.subJuniorBoys.name}}</h3>
                    <p class="mb-1 text-secondary">Chest No: <strong>{{champions.subJuniorBoys.chestNumber}}</strong></p>
                    <p class="mb-3 text-secondary">Team: <strong class="text-uppercase">{{champions.subJuniorBoys.team}}</strong></p>
                    <div class="badge bg-primary fs-6 px-3 py-2">Points: {{champions.subJuniorBoys.totalPoints}}</div>
                </div>
            </div>
        </div>

        <!-- Sub Junior Girls -->
        <div class="col-md-4">
            <div class="card shadow border-danger h-100">
                <div class="card-header bg-danger text-white fw-semibold">Sub Junior — Girls</div>
                <div class="card-body text-center py-4">
                    <h3 class="card-title text-dark fw-bold mb-3">{{champions.subJuniorGirls.name}}</h3>
                    <p class="mb-1 text-secondary">Chest No: <strong>{{champions.subJuniorGirls.chestNumber}}</strong></p>
                    <p class="mb-3 text-secondary">Team: <strong class="text-uppercase">{{champions.subJuniorGirls.team}}</strong></p>
                    <div class="badge bg-danger fs-6 px-3 py-2">Points: {{champions.subJuniorGirls.totalPoints}}</div>
                </div>
            </div>
        </div>

        <!-- Junior Boys -->
        <div class="col-md-4">
            <div class="card shadow border-primary h-100">
                <div class="card-header bg-primary text-white fw-semibold">Junior — Boys</div>
                <div class="card-body text-center py-4">
                    <h3 class="card-title text-dark fw-bold mb-3">{{champions.juniorBoys.name}}</h3>
                    <p class="mb-1 text-secondary">Chest No: <strong>{{champions.juniorBoys.chestNumber}}</strong></p>
                    <p class="mb-3 text-secondary">Team: <strong class="text-uppercase">{{champions.juniorBoys.team}}</strong></p>
                    <div class="badge bg-primary fs-6 px-3 py-2">Points: {{champions.juniorBoys.totalPoints}}</div>
                </div>
            </div>
        </div>

        <!-- Junior Girls -->
