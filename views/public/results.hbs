<div class="max-w-7xl mx-auto px-4 py-8">
    
    <div class="mb-10 text-center">
        <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight">PROGRAM RESULTS</h1>
        <p class="mt-2 text-gray-500">Search and view officially published results.</p>
    </div>

    <!-- Search & Filters -->
    <form action="/results" method="GET" class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 mb-10 flex flex-wrap gap-4 items-end">
        <div class="flex-1 min-w-[200px]">
            <label class="block text-sm font-medium text-gray-700 mb-1">Search Program Name</label>
            <input type="text" name="search" placeholder="e.g. Single Song" class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 px-4 py-2 border">
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
            <select name="category" class="border-gray-300 rounded-lg shadow-sm px-4 py-2 border">
                <option value="">All Categories</option>
                <option value="Senior">Senior</option>
                <option value="Junior">Junior</option>
                <option value="Sub Junior">Sub Junior</option>
                <option value="General">General</option>
                <option value="Team">Team</option>
            </select>
        </div>
        <!-- Add other filters (Gender, Section, Type) similarly -->
        <button type="submit" class="bg-indigo-900 text-white px-6 py-2 rounded-lg font-medium hover:bg-indigo-800 transition">Filter</button>
    </form>

    <!-- Display Results grouped by Program -->
    <div class="space-y-12">
        {{#each groupedResults}}
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                <!-- Program Header (Fulfills Rule: MUST show full classification) -->
                <div class="bg-indigo-50 border-b border-indigo-100 px-6 py-4 flex flex-col md:flex-row justify-between items-center">
                    <div>
                        <h2 class="text-xl font-bold text-indigo-900">{{this.program.name}}</h2>
                        <div class="flex gap-2 mt-2 flex-wrap">
                            <span class="px-3 py-1 bg-white text-indigo-700 text-xs font-semibold rounded-full border border-indigo-200">{{this.program.category}}</span>
                            {{#if this.program.gender}}<span class="px-3 py-1 bg-white text-indigo-700 text-xs font-semibold rounded-full border border-indigo-200">{{this.program.gender}}</span>{{/if}}
                            {{#if this.program.section}}<span class="px-3 py-1 bg-white text-indigo-700 text-xs font-semibold rounded-full border border-indigo-200">{{this.program.section}}</span>{{/if}}
                            {{#if this.program.type}}<span class="px-3 py-1 bg-white text-indigo-700 text-xs font-semibold rounded-full border border-indigo-200">{{this.program.type}}</span>{{/if}}
                        </div>
                    </div>
                </div>

                <!-- Rankings Table -->
                <div class="px-6 py-4">
                    <div class="space-y-4">
                        {{#each this.results}}
                            <div class="flex items-center justify-between p-4 rounded-xl {{#if this.isMine}}bg-yellow-50 border-2 border-yellow-400{{else}}bg-gray-50 border border-gray-100{{/if}}">
                                <div class="flex items-center gap-6">
                                    <!-- Dynamic Trophy/Position -->
                                    <div class="text-2xl font-bold w-12 text-center">
                                        {{#if (eq this.position 1)}}🥇
                                        {{else if (eq this.position 2)}}🥈
                                        {{else if (eq this.position 3)}}🥉
                                        {{else}}<span class="text-gray-400 text-lg">{{this.position}}th</span>
                                        {{/if}}
                                    </div>
                                    
                                    <div>
                                        <div class="flex items-center gap-3">
                                            <h3 class="font-bold text-gray-900 text-lg">
                                                {{#each this.participants}}{{this.name}}{{#unless @last}}, {{/unless}}{{/each}}
                                            </h3>
                                            <!-- Private Check: Highlight if it's the logged in user -->
                                            {{#if this.isMine}}
                                                <span class="bg-yellow-400 text-yellow-900 text-xs px-2 py-1 rounded-md font-bold uppercase">Your Result</span>
                                            {{/if}}
                                        </div>
                                        <div class="text-sm text-gray-500 mt-1">
                                            Chess No: {{#each this.participants}}{{this.chessNumber}}{{#unless @last}}, {{/unless}}{{/each}}
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="text-right">
                                    <div class="inline-block px-4 py-1 rounded-full text-sm font-bold {{#if (eq this.team 'Hermos')}}bg-blue-100 text-blue-800{{else}}bg-red-100 text-red-800{{/if}}">
                                        {{this.team}}
                                    </div>
                                    <div class="text-xl font-black text-gray-900 mt-1">{{this.score}} <span class="text-sm font-normal text-gray-500">pts</span></div>
                                </div>
                            </div>
                        {{/each}}
                    </div>
                </div>
            </div>
        {{else}}
            <div class="text-center py-20">
                <p class="text-gray-500 text-lg">No published results match your search.</p>
                
            </div>
        {{/each}}
    </div>
</div>