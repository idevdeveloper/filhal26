<div class="max-w-3xl mx-auto px-4 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900">Submit Program Results</h1>
        <p class="text-gray-500 mt-1">Welcome, {{judge.name}} | Enter placement chest numbers for review</p>
    </div>

    {{#if success}}
        <div class="bg-green-50 border border-green-200 p-4 mb-6 rounded-xl text-green-700 font-bold">{{success}}</div>
    {{/if}}
    {{#if error}}
        <div class="bg-red-50 border border-red-200 p-4 mb-6 rounded-xl text-red-700 font-bold">{{error}}</div>
    {{/if}}

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        <form action="/judge/submit-result" method="POST" class="space-y-6">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Program Name</label>
                <input type="text" name="programName" placeholder="e.g. Oppana, Light Music" required class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Category</label>
                    <select name="category" required class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none">
                        <option value="Sub Junior">Sub Junior</option>
                        <option value="Junior">Junior</option>
                        <option value="Senior">Senior</option>
                        <option value="General">General</option>
                        <option value="Team">Team</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Section</label>
                    <select name="section" required class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none">
                        <option value="Main Stage">Main Stage</option>
                        <option value="Off Stage">Off Stage</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Gender</label>
                    <select name="gender" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none">
                        <option value="">N/A (Team/General)</option>
                        <option value="Boys">Boys</option>
                        <option value="Girls">Girls</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Type</label>
                    <select name="type" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none">
                        <option value="">N/A (Team/General)</option>
                        <option value="Individual">Individual</option>
                        <option value="Group">Group</option>
                    </select>
                </div>
            </div>

            <!-- Placement Inputs for Judges -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-gray-100">
                <div class="bg-amber-50 p-4 rounded-xl border border-amber-200">
                    <label class="block text-xs font-black text-amber-800 uppercase mb-2">🥇 1st Place (10 / 20 pts)</label>
                    <input type="text" name="firstPlace" placeholder="Chest No. (e.g. 101, 102)" class="w-full px-3 py-2 bg-white border border-amber-300 rounded-lg outline-none font-bold">
                </div>
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                    <label class="block text-xs font-black text-slate-700 uppercase mb-2">🥈 2nd Place (5 / 15 pts)</label>
                    <input type="text" name="secondPlace" placeholder="Chest No." class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg outline-none font-bold">
                </div>
                <div class="bg-orange-50 p-4 rounded-xl border border-orange-200">
                    <label class="block text-xs font-black text-orange-800 uppercase mb-2">🥉 3rd Place (3 / 10 pts)</label>
                    <input type="text" name="thirdPlace" placeholder="Chest No." class="w-full px-3 py-2 bg-white border border-orange-300 rounded-lg outline-none font-bold">
                </div>
            </div>

            <button type="submit" class="w-full py-4 bg-purple-600 hover:bg-purple-700 text-white font-bold text-lg rounded-xl transition shadow-lg shadow-purple-100">
                Submit Results for Review
            </button>
        </form>
    </div>
</div>