<div class="max-w-3xl mx-auto px-4 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900">Submit Program Results</h1>
        <p class="text-gray-500 mt-1">Welcome, {{judge.name}} | Select program and choose participants for review</p>
    </div>

    {{#if success}}
        <div class="bg-green-50 border border-green-200 p-4 mb-6 rounded-xl text-green-700 font-bold">{{success}}</div>
    {{/if}}
    {{#if error}}
        <div class="bg-red-50 border border-red-200 p-4 mb-6 rounded-xl text-red-700 font-bold">{{error}}</div>
    {{/if}}

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        <form action="/judge/submit-result" method="POST" class="space-y-6">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Select Program</label>
                <select name="programId" id="programSelect" required class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none" onchange="fetchParticipants(this.value)">
                    <option value="">-- Choose Program --</option>
                    {{#each programs}}
                        <option value="{{this._id}}" data-category="{{this.category}}">{{this.name}} ({{this.category}} • {{this.section}} {{#if this.gender}}• {{this.gender}}{{/if}})</option>
                    {{/each}}
                </select>
            </div>

            <!-- Placement Dropdown Inputs for Judges -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-gray-100">
                <div class="bg-amber-50 p-4 rounded-xl border border-amber-200">
                    <label id="label-first" class="block text-xs font-black text-amber-800 uppercase mb-2">🥇 1st Place (10 pts)</label>
                    <select name="firstPlace" id="firstPlaceSelect" class="w-full px-3 py-2 bg-white border border-amber-300 rounded-lg outline-none font-bold participant-dropdown">
                        <option value="">Select Participant</option>
                    </select>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                    <label id="label-second" class="block text-xs font-black text-slate-700 uppercase mb-2">🥈 2nd Place (7 pts)</label>
                    <select name="secondPlace" id="secondPlaceSelect" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg outline-none font-bold participant-dropdown">
                        <option value="">Select Participant</option>
                    </select>
                </div>
                <div class="bg-orange-50 p-4 rounded-xl border border-orange-200">
                    <label id="label-third" class="block text-xs font-black text-orange-800 uppercase mb-2">🥉 3rd Place (5 pts)</label>
                    <select name="thirdPlace" id="thirdPlaceSelect" class="w-full px-3 py-2 bg-white border border-orange-300 rounded-lg outline-none font-bold participant-dropdown">
                        <option value="">Select Participant</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="w-full py-4 bg-purple-600 hover:bg-purple-700 text-white font-bold text-lg rounded-xl transition shadow-lg shadow-purple-100">
                Submit Results for Review
            </button>
        </form>
    </div>
</div>

<script>
async function fetchParticipants(programId) {
    const dropdowns = document.querySelectorAll('.participant-dropdown');
    
    // Reset dropdowns if no program is selected
    if (!programId) {
        dropdowns.forEach(d => {
            d.innerHTML = '<option value="">Select Participant</option>';
        });
        return;
    }

    // Update point labels based on selected option's data-category attribute
    const selectElem = document.getElementById('programSelect');
    const selectedOption = selectElem.options[selectElem.selectedIndex];
    const category = selectedOption.getAttribute('data-category');
    
    const labelFirst = document.getElementById('label-first');
    const labelSecond = document.getElementById('label-second');
    const labelThird = document.getElementById('label-third');

    if (category === 'General' || category === 'Team') {
        labelFirst.textContent = '🥇 1st Place (20 pts)';
        labelSecond.textContent = '🥈 2nd Place (15 pts)';
        labelThird.textContent = '🥉 3rd Place (10 pts)';
    } else {
        labelFirst.textContent = '🥇 1st Place (10 pts)';
        labelSecond.textContent = '🥈 2nd Place (7 pts)';
        labelThird.textContent = '🥉 3rd Place (5 pts)';
    }

    try {
        const response = await fetch(`/judge/api/program-participants/${programId}`);
        const participants = await response.json();

        dropdowns.forEach(d => {
            let optionsHTML = '<option value="">Select Participant</option>';
            participants.forEach(p => {
                optionsHTML += `<option value="${p._id}">${p.name} (Chest: ${p.chessNumber} - ${p.team})</option>`;
            });
            d.innerHTML = optionsHTML;
        });
    } catch (err) {
        console.error('Error fetching participants for program:', err);
    }
}
</script>