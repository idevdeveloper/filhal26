<div class="max-w-xl mx-auto px-4 py-8">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-extrabold text-gray-900">Edit Submission</h1>
            <p class="text-gray-500 text-sm mt-1">Modify placement and score for {{result.program.name}}</p>
        </div>
        <a href="/judge/results" class="text-sm font-bold text-purple-600 hover:underline">← Back</a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        <form action="/judge/edit-result/{{result._id}}" method="POST" class="space-y-6">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Program</label>
                <input type="text" disabled value="{{result.program.name}} ({{result.program.category}})" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-500 cursor-not-allowed">
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Position & Auto Score</label>
                <select name="position" id="positionSelect" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none" onchange="updateScore(this.value)">
                    <option value="1" {{#if (eq result.position 1)}}selected{{/if}}>1st Place</option>
                    <option value="2" {{#if (eq result.position 2)}}selected{{/if}}>2nd Place</option>
                    <option value="3" {{#if (eq result.position 3)}}selected{{/if}}>3rd Place</option>
                </select>
                <input type="hidden" name="score" id="scoreInput" value="{{result.score}}">
            </div>

            <button type="submit" class="w-full py-4 bg-purple-600 hover:bg-purple-700 text-white font-bold text-lg rounded-xl transition shadow-lg shadow-purple-100">
                Update Result
            </button>
        </form>
    </div>
</div>

<script>
    // Check if category is General or Team from the template data
    const programCategory = "{{result.program.category}}";
    const isHigherPoints = (programCategory === 'General' || programCategory === 'Team');

    function updateScore(pos) {
        let scoreMap;
        if (isHigherPoints) {
            scoreMap = { '1': 20, '2': 15, '3': 10 };
        } else {
            scoreMap = { '1': 10, '2': 7, '3': 5 };
        }
        document.getElementById('scoreInput').value = scoreMap[pos] || (isHigherPoints ? 20 : 10);
    }

    // Initialize correct score on page load if not already set
    window.addEventListener('DOMContentLoaded', () => {
        const currentPos = document.getElementById('positionSelect').value;
        updateScore(currentPos);
    });
</script>