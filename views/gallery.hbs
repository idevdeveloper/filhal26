<div class="max-w-7xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-black text-gray-900">Filhal Fest Photo Gallery</h1>
            <p class="text-gray-500 text-sm mt-1">Explore event moments framed and ready for download.</p>
        </div>
        {{#if admin}}
        <a href="/admin/photos/manage" class="px-5 py-2.5 bg-indigo-600 text-white font-bold rounded-xl shadow hover:bg-indigo-700 text-sm">
            Manage Media ⚙️
        </a>
        {{/if}}
    </div>

    {{#if photos.length}}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {{#each photos}}
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden flex flex-col">
            <!-- Preview Box showing photo with frame overlaid directly -->
            <div class="relative w-full aspect-[1080/1350] bg-gray-100 overflow-hidden">
                <!-- Base Photo -->
                <img src="{{this.imageUrl}}" alt="{{this.title}}" class="absolute inset-0 w-full h-full object-cover">
                <!-- Overlay Frame -->
                <img src="/images/frame.png" alt="Frame" class="absolute inset-0 w-full h-full object-cover pointer-events-none">
            </div>
            
            <div class="p-6 flex-1 flex flex-col justify-between">
                <h3 class="font-bold text-lg text-gray-900 mb-6">{{this.title}}</h3>
                
                <div>
                    <!-- Single Download Button -->
                    <button onclick="downloadFramedPhoto('{{this.imageUrl}}')" 
                            class="w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-center text-sm shadow-sm transition-all flex items-center justify-center gap-2">
                        <span>Download</span>
                        <span>🖼️</span>
                    </button>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <div class="text-center py-20 bg-gray-50 rounded-3xl border border-dashed border-gray-200">
        <p class="text-gray-400 font-medium text-lg">No photos uploaded yet. Check back soon!</p>
    </div>
    {{/if}}
</div>

<script>
    function downloadFramedPhoto(photoUrl) {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');

        const baseImage = new Image();
        baseImage.crossOrigin = "anonymous";
        baseImage.src = photoUrl;

        baseImage.onload = function () {
            const frameImage = new Image();
            frameImage.src = '/images/frame.png';

            frameImage.onload = function () {
                canvas.width = baseImage.naturalWidth;
                canvas.height = baseImage.naturalHeight;

                ctx.drawImage(baseImage, 0, 0);
                ctx.drawImage(frameImage, 0, 0, canvas.width, canvas.height);

                const dataURL = canvas.toDataURL('image/jpeg', 1.0);

                const link = document.createElement('a');
                link.download = 'filhal-fest-framed-photo.jpg';
                link.href = dataURL;
                link.click();
            };

            frameImage.onerror = function() {
                alert("Error loading the frame graphic. Please verify /public/images/frame.png exists.");
            };
        };
        
        baseImage.onerror = function() {
            alert("Error loading the source photo.");
        };
    }
</script>