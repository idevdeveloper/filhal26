<div class="max-w-7xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-black text-gray-900">Filhal Fest Photo Gallery</h1>
            <p class="text-gray-500 text-sm mt-1">Explore event moments framed and ready for download.</p>
        </div>
        {{#if admin}}
        <a href="/admin/photos/manage" class="px-5 py-2.5 bg-indigo-600 text-white font-bold rounded-xl shadow hover:bg-indigo-700 text-sm">
            Manage Media ⚙️
        </a>
        {{/if}}
    </div>

    {{#if photos.length}}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {{#each photos}}
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden flex flex-col">
            <!-- Dynamic container sizing & matching frame asset lookup -->
            <div class="relative w-full {{getAspectClass this.orientation}} bg-gray-100 overflow-hidden">
                <img src="{{this.imageUrl}}" crossorigin="anonymous" alt="{{this.title}}" class="absolute inset-0 w-full h-full object-cover">
                <img src="{{getFramePath this.gender this.orientation}}" crossorigin="anonymous" alt="Frame" class="absolute inset-0 w-full h-full object-cover pointer-events-none">
            </div>
            
            <div class="p-6 flex-1 flex flex-col justify-between">
                {{#if this.title}}
                    <h3 class="font-bold text-lg text-gray-900 mb-6">{{this.title}}</h3>
                {{else}}
                    <div class="mb-6"></div>
                {{/if}}
                
                <div>
                    <button onclick="downloadFramedPhoto(this)" 
                            class="w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-center text-sm shadow-sm transition-all flex items-center justify-center gap-2">
                        <span>Download</span>
                        <span>🖼️</span>
                    </button>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <div class="text-center py-20 bg-gray-50 rounded-3xl border border-dashed border-gray-200">
        <p class="text-gray-400 font-medium text-lg">No photos uploaded yet. Check back soon!</p>
    </div>
    {{/if}}
</div>

<script>
    function downloadFramedPhoto(buttonElement) {
        try {
            const card = buttonElement.closest('.bg-white');
            const baseImg = card.querySelector('img:not([alt="Frame"])');
            const frameImg = card.querySelector('img[alt="Frame"]');

            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');

            canvas.width = baseImg.naturalWidth;
            canvas.height = baseImg.naturalHeight;

            ctx.drawImage(baseImg, 0, 0, canvas.width, canvas.height);
            ctx.drawImage(frameImg, 0, 0, canvas.width, canvas.height);

            const dataURL = canvas.toDataURL('image/jpeg', 1.0);

            const link = document.createElement('a');
            link.download = 'filhal-fest-framed-photo.jpg';
            link.href = dataURL;
            link.click();
        } catch (err) {
            console.error(err);
            alert("Error generating the framed download. Please check the console.");
        }
    }
</script>