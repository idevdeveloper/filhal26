<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">Manage Participants</h1>
            <p class="text-gray-500 mt-1">View all registered users.</p>
        </div>
        <a href="/admin/add-user" class="bg-indigo-600 text-white px-5 py-2 rounded-lg font-bold shadow-md hover:bg-indigo-700 transition">
            + Add Participant
        </a>
    </div>

    {{#if success}}
        <div class="bg-green-50 border-l-4 border-green-500 p-4 mb-8">
            <p class="text-green-700 font-bold">{{success}}</p>
        </div>
    {{/if}}

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full text-left border-collapse whitespace-nowrap">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-200 text-xs text-gray-500 uppercase tracking-wider">
                    <th class="p-4 font-bold">Chess No.</th>
                    <th class="p-4 font-bold">Name</th>
                    <th class="p-4 font-bold">Category</th>
                    <th class="p-4 font-bold">Team</th>
                    <th class="p-4 font-bold text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {{#each users}}
                <tr class="hover:bg-gray-50 transition">
                    <td class="p-4 font-black text-indigo-700">{{this.chessNumber}}</td>
                    <td class="p-4 font-bold text-gray-900">{{this.name}}</td>
                    <td class="p-4">
                        <span class="bg-gray-100 text-gray-600 text-xs px-2 py-1 rounded font-bold uppercase">{{this.category}} {{this.gender}}</span>
                    </td>
                    <td class="p-4 font-bold {{#if (eq this.team 'Hermos')}}text-blue-600{{else}}text-red-600{{/if}}">{{this.team}}</td>
                    <td class="p-4 text-right flex justify-end gap-2">
                        <!-- Edit Button -->
                        <a href="/admin/edit-user/{{this._id}}" class="text-sm px-3 py-1 rounded border bg-white border-gray-300 text-gray-700 hover:bg-gray-50 font-medium transition">
                            Edit
                        </a>
                        
                        <!-- Delete Button (with JS confirmation) -->
                        <form action="/admin/delete-user/{{this._id}}" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this participant? This action cannot be undone.');">
                            <button type="submit" class="text-sm bg-red-50 text-red-600 border border-red-100 px-3 py-1 rounded font-medium hover:bg-red-100 transition">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>