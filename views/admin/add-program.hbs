<div class="max-w-2xl mx-auto px-4 py-8">
    <div class="bg-white rounded-2xl shadow border border-gray-200 p-8">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-900">Add New Program</h1>
            <a href="/admin/programs" class="text-sm text-indigo-600 font-medium hover:underline">&larr; Back to Programs</a>
        </div>

        {{#if error}}
            <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6">
                <p class="text-red-700 font-medium">{{error}}</p>
            </div>
        {{/if}}

        <form action="/admin/add-program" method="POST" class="space-y-6">
            <div>
                <label class="block text-sm font-medium text-gray-700">Program Name</label>
                <input type="text" name="name" required placeholder="e.g. Oppana, Light Music" class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border focus:ring-2 focus:ring-indigo-500 outline-none">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Category</label>
                    <select name="category" id="categorySelect" required class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border focus:ring-2 focus:ring-indigo-500 outline-none" onchange="toggleTeamFields()">
                        <option value="Sub Junior">Sub Junior</option>
                        <option value="Junior">Junior</option>
                        <option value="Senior">Senior</option>
                        <option value="General">General</option>
                        <option value="Team">Team</option>
                    </select>
                </div>
                <div id="genderContainer">
                    <label class="block text-sm font-medium text-gray-700">Gender</label>
                    <select name="gender" id="genderSelect" class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border focus:ring-2 focus:ring-indigo-500 outline-none">
                        <option value="Boys">Boys</option>
                        <option value="Girls">Girls</option>
                    </select>
                    <p class="text-xs text-gray-400 mt-1">Leave as is if Team category</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Section</label>
                    <select name="section" required class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border focus:ring-2 focus:ring-indigo-500 outline-none">
                        <option value="Main Stage">Main Stage</option>
                        <option value="Off Stage">Off Stage</option>
                    </select>
                </div>
                <div id="typeContainer">
                    <label class="block text-sm font-medium text-gray-700">Program Type</label>
                    <select name="type" id="typeSelect" class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border focus:ring-2 focus:ring-indigo-500 outline-none">
                        <option value="Individual">Individual</option>
                        <option value="Group">Group</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="w-full bg-indigo-600 text-white py-3 px-4 rounded-xl font-bold hover:bg-indigo-700 shadow-md transition">
                Create Program
            </button>
        </form>
    </div>
</div>

<script>
function toggleTeamFields() {
    const category = document.getElementById('categorySelect').value;
    const genderContainer = document.getElementById('genderContainer');
    const typeContainer = document.getElementById('typeContainer');
    const genderSelect = document.getElementById('genderSelect');
    const typeSelect = document.getElementById('typeSelect');

    if (category === 'Team') {
        genderContainer.style.display = 'none';
        typeContainer.style.display = 'none';
        genderSelect.removeAttribute('required');
        typeSelect.removeAttribute('required');
    } else {
        genderContainer.style.display = 'block';
        typeContainer.style.display = 'block';
        genderSelect.setAttribute('required', 'true');
        typeSelect.setAttribute('required', 'true');
    }
}

// Run on page load
document.addEventListener('DOMContentLoaded', toggleTeamFields);
</script>