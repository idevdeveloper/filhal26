<div class="max-w-2xl mx-auto px-4 py-8">
    <div class="bg-white rounded-2xl shadow border border-gray-200 p-8">
        <h1 class="text-2xl font-bold text-gray-900 mb-6">Add New Participant</h1>
        
        {{#if error}}
            <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6">
                <p class="text-red-700 font-medium">{{error}}</p>
            </div>
        {{/if}}

        <form action="/admin/add-user" method="POST" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Full Name</label>
                    <input type="text" name="name" required class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Chess Number (Unique)</label>
                    <input type="text" name="chessNumber" required class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Category</label>
                    <select name="category" id="categorySelect" required class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border" onchange="filterPrograms()">
                        <option value="Sub Junior">Sub Junior</option>
                        <option value="Junior">Junior</option>
                        <option value="Senior">Senior</option>
                        <option value="General">General</option>
                        <option value="Team">Team</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Gender</label>
                    <select name="gender" id="genderSelect" required class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border" onchange="filterPrograms()">
                        <option value="Boys">Boys</option>
                        <option value="Girls">Girls</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Team</label>
                    <select name="team" required class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border">
                        <option value="Hermos">Hermos</option>
                        <option value="Gibraltar">Gibraltar</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Temporary Password</label>
                    <input type="text" name="password" required class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border" value="filhal2026">
                </div>
            </div>

            <!-- Program Assignment Checkboxes Section with Data Attributes -->
            <div class="pt-4 border-t border-gray-200">
                <label class="block text-sm font-bold text-gray-700 mb-2">Assign Programs (Matching Category & Gender)</label>
                <div class="max-h-52 overflow-y-auto space-y-2 border border-gray-200 p-4 rounded-xl bg-gray-50" id="programList">
                    {{#if programs.length}}
                        {{#each programs}}
                            <label class="program-item flex items-center space-x-3 p-2 hover:bg-white rounded-lg transition cursor-pointer" 
                                   data-category="{{this.category}}" 
                                   data-gender="{{this.gender}}">
                                <input type="checkbox" name="programs" value="{{this._id}}" class="w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
                                <span class="text-sm font-medium text-gray-800">
                                    {{this.name}} <span class="text-xs text-gray-500">({{this.category}} • {{this.section}} {{#if this.gender}}• {{this.gender}}{{/if}})</span>
                                </span>
                            </label>
                        {{/each}}
                    {{else}}
                        <p class="text-xs text-gray-500 text-center py-4">No programs found. Please add programs first.</p>
                    {{/if}}
                </div>
            </div>

            <button type="submit" class="w-full bg-indigo-600 text-white py-3 px-4 rounded-xl font-bold hover:bg-indigo-700 shadow-md transition">
                Create Participant
            </button>
        </form>
    </div>
</div>

<script>
function filterPrograms() {
    const selectedCategory = document.getElementById('categorySelect').value;
    const selectedGender = document.getElementById('genderSelect').value;
    const programItems = document.querySelectorAll('.program-item');

    programItems.forEach(item => {
        const progCategory = item.getAttribute('data-category');
        const progGender = item.getAttribute('data-gender');

        // Show if category matches (or is General/Team) AND gender matches (or program has no gender requirement)
        const categoryMatch = (progCategory === selectedCategory || progCategory === 'General' || progCategory === 'Team');
        const genderMatch = (!progGender || progGender === selectedGender);

        if (categoryMatch && genderMatch) {
            item.style.display = 'flex';
        } else {
            item.style.display = 'none';
        }
    });
}

// Run on page load to set initial state
document.addEventListener('DOMContentLoaded', filterPrograms);
</script>