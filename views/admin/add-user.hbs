<div class="max-w-2xl mx-auto px-4 py-8">
    <div class="bg-white rounded-2xl shadow border border-gray-200 p-8">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-900">Edit Participant</h1>
            <a href="/admin/users" class="text-sm text-indigo-600 font-medium hover:underline">&larr; Back to Users</a>
        </div>
        
        {{#if error}}
            <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6">
                <p class="text-red-700 font-medium">{{error}}</p>
            </div>
        {{/if}}

        <form action="/admin/edit-user/{{editUser._id}}" method="POST" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Full Name</label>
                    <input type="text" name="name" value="{{editUser.name}}" required class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Chess Number (Unique)</label>
                    <input type="text" name="chessNumber" value="{{editUser.chessNumber}}" required class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Category</label>
                    <select name="category" id="categorySelect" required class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border" onchange="filterPrograms()">
                        <option value="Sub Junior" {{#if (eq editUser.category "Sub Junior")}}selected{{/if}}>Sub Junior</option>
                        <option value="Junior" {{#if (eq editUser.category "Junior")}}selected{{/if}}>Junior</option>
                        <option value="Senior" {{#if (eq editUser.category "Senior")}}selected{{/if}}>Senior</option>
                        <option value="General" {{#if (eq editUser.category "General")}}selected{{/if}}>General</option>
                        <option value="Team" {{#if (eq editUser.category "Team")}}selected{{/if}}>Team</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Gender</label>
                    <select name="gender" id="genderSelect" required class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border" onchange="filterPrograms()">
                        <option value="Boys" {{#if (eq editUser.gender "Boys")}}selected{{/if}}>Boys</option>
                        <option value="Girls" {{#if (eq editUser.gender "Girls")}}selected{{/if}}>Girls</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Team</label>
                    <select name="team" required class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border">
                        <option value="Hermos" {{#if (eq editUser.team "Hermos")}}selected{{/if}}>Hermos</option>
                        <option value="Gibraltar" {{#if (eq editUser.team "Gibraltar")}}selected{{/if}}>Gibraltar</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Change Password</label>
                    <input type="text" name="password" placeholder="Leave blank to keep current" class="mt-1 w-full border-gray-300 rounded-md shadow-sm py-2 px-3 border">
                </div>
            </div>

            <!-- Program Assignment Checkboxes Section -->
            <div class="pt-4 border-t border-gray-200">
                <label class="block text-sm font-bold text-gray-700 mb-2">Assigned Programs</label>
                <div class="max-h-52 overflow-y-auto space-y-2 border border-gray-200 p-4 rounded-xl bg-gray-50" id="programList">
                    {{#if programs.length}}
                        {{#each programs}}
                            <label class="program-item flex items-center space-x-3 p-2 hover:bg-white rounded-lg transition cursor-pointer">
                                <input type="checkbox" name="programs" value="{{this._id}}" 
                                    data-category="{{this.category}}" 
                                    data-gender="{{this.gender}}"
                                    {{#if (includes ../editUser.programs this._id)}}checked{{/if}} 
                                    class="w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
                                <span class="text-sm font-medium text-gray-800">
                                    {{this.name}} <span class="text-xs text-gray-500">({{this.category}} • {{this.section}} {{#if this.gender}}• {{this.gender}}{{/if}})</span>
                                </span>
                            </label>
                        {{/each}}
                    {{else}}
                        <p class="text-xs text-gray-500 text-center py-4">No programs found.</p>
                    {{/if}}
                </div>
            </div>

            <button type="submit" class="w-full bg-indigo-600 text-white py-3 px-4 rounded-xl font-bold hover:bg-indigo-700 shadow-md transition">
                Save Changes
            </button>
        </form>
    </div>
</div>

<script>
function filterPrograms() {
    const selectedCategory = document.getElementById('categorySelect').value;
    const selectedGender = document.getElementById('genderSelect').value;
    const programItems = document.querySelectorAll('.program-item');

    programItems.forEach(item => {
        const checkbox = item.querySelector('input[type="checkbox"]');
        const progCategory = checkbox.getAttribute('data-category');
        const progGender = checkbox.getAttribute('data-gender');

        // Exclude Team category programs entirely
        if (progCategory === 'Team') {
            item.style.display = 'none';
            return;
        }

        // Show if category matches participant's category OR is General, AND gender matches
        const categoryMatch = (progCategory === selectedCategory || progCategory === 'General');
        const genderMatch = (!progGender || progGender === selectedGender);

        if (categoryMatch && genderMatch) {
            item.style.display = 'flex';
        } else {
            item.style.display = 'none';
        }
    });
}

// Run immediately on script load to apply filter properly
document.addEventListener('DOMContentLoaded', filterPrograms);
</script>