<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">Manage Judges</h1>
            <p class="text-gray-500 mt-1">Create accounts and manage event judges.</p>
        </div>
        <a href="/admin/dashboard" class="text-sm font-bold text-indigo-600 hover:text-indigo-800">← Back to Dashboard</a>
    </div>

    {{#if success}}
        <div class="mb-6 p-4 bg-green-50 text-green-700 rounded-xl border border-green-200">{{success}}</div>
    {{/if}}
    {{#if error}}
        <div class="mb-6 p-4 bg-red-50 text-red-700 rounded-xl border border-red-200">{{error}}</div>
    {{/if}}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Add Judge Form -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 h-fit">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Add New Judge</h2>
            <form action="/admin/add-judge" method="POST" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Judge Name / Username</label>
                    <input type="text" name="name" required class="w-full px-4 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                    <input type="password" name="password" required class="w-full px-4 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl transition shadow-md">
                    Create Judge
                </button>
            </form>
        </div>

        <!-- Judges List Table -->
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-6 border-b border-gray-100">
                <h2 class="text-xl font-bold text-gray-900">Existing Judges</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-gray-400 uppercase text-xs tracking-wider">
                            <th class="p-4">Name</th>
                            <th class="p-4">Role</th>
                            <th class="p-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        {{#each judges}}
                        <tr>
                            <td class="p-4 font-bold text-gray-900">{{name}}</td>
                            <td class="p-4"><span class="px-3 py-1 bg-purple-50 text-purple-600 rounded-full text-xs font-bold">JUDGE</span></td>
                            <td class="p-4 text-right">
                                <form action="/admin/delete-judge/{{_id}}" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this judge?');">
                                    <button type="submit" class="text-red-500 hover:text-red-700 font-bold text-xs bg-red-50 px-3 py-1.5 rounded-lg">Delete</button>
                                </form>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="3" class="p-8 text-center text-gray-400">No judges created yet.</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>