<div class="max-w-7xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-black text-gray-900">Manage Media Library</h1>
            <p class="text-gray-500 text-sm mt-1">Review uploaded items or delete unwanted photos from the public gallery.</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/admin/photos/upload" class="px-5 py-2.5 bg-indigo-600 text-white font-bold rounded-xl shadow-sm hover:bg-indigo-700 text-sm">
                + Upload New Photo
            </a>
            <a href="/gallery" target="_blank" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold rounded-xl text-sm transition-colors">
                View Gallery ↗
            </a>
            {{#if photos.length}}
            <form action="/admin/photos/clear-all" method="POST" onsubmit="return confirm('WARNING: Are you sure you want to delete ALL uploaded photos? This action cannot be undone.');">
                <button type="submit" class="px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl text-sm shadow-sm transition-all">
                    Clear All Photos 🗑️
                </button>
            </form>
            {{/if}}
        </div>
    </div>

    {{#if photos.length}}
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
        {{#each photos}}
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden flex flex-col justify-between">
            <div>
                <!-- Image Preview Box matching orientation aspect ratio -->
                <div class="relative w-full {{getAspectClass this.orientation}} bg-gray-100 overflow-hidden">
                    <img src="{{this.imageUrl}}" alt="{{this.title}}" class="absolute inset-0 w-full h-full object-cover">
                </div>
                <div class="p-6">
                    {{#if this.title}}
                        <h3 class="font-bold text-base text-gray-900 truncate">{{this.title}}</h3>
                    {{else}}
                        <p class="text-gray-400 text-sm italic">No title provided</p>
                    {{/if}}
                    <p class="text-xs text-gray-400 mt-1 uppercase tracking-wider font-semibold">{{this.gender}} • {{this.orientation}}</p>
                </div>
            </div>
            <div class="p-6 pt-0">
                <form action="/admin/photos/delete/{{this._id}}" method="POST" onsubmit="return confirm('Are you sure you want to delete this photo?');">
                    <button type="submit" class="w-full py-3 bg-red-50 hover:bg-red-100 text-red-600 font-bold rounded-xl text-sm transition-colors">
                        Delete Photo 🗑️
                    </button>
                </form>
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <div class="text-center py-20 bg-gray-50 rounded-3xl border border-dashed border-gray-200">
        <p class="text-gray-400 font-medium text-lg">No media uploaded yet.</p>
        <a href="/admin/photos/upload" class="inline-block mt-4 text-indigo-600 font-bold text-sm hover:underline">Upload your first photo &rarr;</a>
    </div>
    {{/if}}
</div>